# Telegram bot token — get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API key — get from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key — for generating educational illustrations (platform.openai.com)
# Optional: bot works without this; image requests need it enabled
OPENAI_API_KEY=your_openai_api_key_here

# Your personal Telegram chat ID — find it by messaging @userinfobot
ADMIN_CHAT_ID=your_telegram_chat_id_here

# Secret key to protect the admin API and website
# Choose any strong random string, e.g.: openssl rand -hex 24
ADMIN_API_KEY=change-this-to-a-strong-secret-key

# Port (Railway/Render set this automatically — leave blank locally or set to 3001)
PORT=3001

# Where activation codes & users are stored (leave blank locally — uses project folder)
# On Render this is set automatically to /var/data with a persistent disk
# DATA_DIR=/var/data
